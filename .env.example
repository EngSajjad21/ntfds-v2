# Copy to .env and export (or use docker compose --env-file). Everything is optional.
NTFDS_HOST=127.0.0.1
NTFDS_PORT=5000
NTFDS_API_TOKEN=                # set to require a token for UI/API/metrics/websocket
SECRET_KEY=
DATABASE_URL=sqlite:///network_monitor.db
NTFDS_MAX_WORKERS=32            # concurrent probes
NTFDS_RAW_RETENTION_DAYS=7      # per-check rows; hourly roll-ups are kept ~400 days
NTFDS_ALLOW_PUBLIC_SCAN=0       # 1 = allow port scan / discovery of public IPs (only where you're authorised)
NTFDS_REFERENCE_HOSTS=1.1.1.1,8.8.8.8   # used by Auto-diagnose to tell LAN faults from ISP faults
# E-mail alert channel
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ntfds@localhost
# Map tiles. Public OSM servers need a Referer and limit heavy use; use your own tile server or a keyed provider in production.
NTFDS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
